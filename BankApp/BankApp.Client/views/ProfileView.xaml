<Page
    x:Class="BankApp.Client.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F4F6FA">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBlue"       Color="#1A3C6E"/>
        <SolidColorBrush x:Key="AccentBlue"        Color="#2563EB"/>
        <SolidColorBrush x:Key="LightBlue"         Color="#EFF4FF"/>
        <SolidColorBrush x:Key="SidebarBg"         Color="#0F2A4A"/>
        <SolidColorBrush x:Key="SidebarText"       Color="#B0C4DE"/>
        <SolidColorBrush x:Key="SidebarActiveBg"   Color="#2563EB"/>
        <SolidColorBrush x:Key="CardBg"            Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor"       Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#64748B"/>
        <SolidColorBrush x:Key="InputBg"           Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DangerRed"         Color="#EF4444"/>

        <SolidColorBrush x:Key="TextControlForeground"              Color="#1E293B"/>
        <SolidColorBrush x:Key="TextControlForegroundPointerOver"   Color="#1E293B"/>
        <SolidColorBrush x:Key="TextControlForegroundFocused"       Color="#1E293B"/>
        <SolidColorBrush x:Key="TextControlForegroundDisabled"      Color="#94A3B8"/>

        <SolidColorBrush x:Key="TextControlBackground"              Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"   Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextControlBackgroundFocused"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextControlBackgroundDisabled"      Color="#F1F5F9"/>

        <!-- Sidebar Nav Button — full ControlTemplate prevents WinUI overriding foreground in hover/pressed -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="20,10"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="CornerRadius"               Value="6"/>
            <Setter Property="Margin"                     Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1A3A5C"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#D0E4F7"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#152E4D"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#B0C4DE"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#4A6080"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Foreground="#B0C4DE"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Button -->
        <Style x:Key="NavItemActiveStyle" TargetType="Button">
            <Setter Property="Background"                 Value="#2563EB"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="20,10"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="CornerRadius"               Value="6"/>
            <Setter Property="Margin"                     Value="8,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1D55D4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1848BC"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Foreground="White"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1D55D4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1848BC"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#93B4F0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="White"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline Button -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#EFF4FF"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#DBEAFE"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#2563EB"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button (icon-only) -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#F1F5F9"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#E2E8F0"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button — inactive -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1E293B"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#2563EB"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#64748B"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Button — active -->
        <Style x:Key="TabButtonActiveStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="#2563EB"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1D55D4"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#1848BC"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="#2563EB"
                                              FontSize="{TemplateBinding FontSize}"
                                              FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Input -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="Foreground"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CornerRadius"    Value="6"/>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="Foreground"      Value="#1E293B"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CornerRadius"    Value="6"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin"     Value="0,0,0,16"/>
        </Style>

    </Page.Resources>


    <!-- Root: Sidebar + Main -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════
             SIDEBAR
        ════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#0F2A4A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Border Grid.Row="0" Padding="20,24,20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="B" FontSize="18" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BankApp" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="#1E3A5F" Margin="16,0"/>

            <!-- Nav Items -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden"
                          Padding="0,12,0,0">
                <StackPanel>

                    <Button Style="{StaticResource NavItemStyle}"
                            Click="DashboardNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Dashboard" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Transfers" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Bill Payments" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8C0;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Cards" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Transaction History" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8A1;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Currency Exchange" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Savings &amp; Loans" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Investments &amp; Trading" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Statistics" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8F2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                            <TextBlock Text="Support" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Profile — Active -->
                    <Button Style="{StaticResource NavItemActiveStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0" Foreground="White"/>
                            <TextBlock Text="Profile" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- Logout -->
            <Border Grid.Row="3" Padding="8,12">
                <Button x:Name="LogoutButton"
                        Style="{StaticResource NavItemStyle}"
                        Click="LogoutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Margin="0,0,10,0" Foreground="#B0C4DE"/>
                        <TextBlock Text="Logout" Foreground="#B0C4DE" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════
             MAIN CONTENT
        ════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Profile"
                           FontSize="22" FontFamily="Segoe UI Semibold"
                           Foreground="#1E293B"/>
                <TextBlock Text=" / Settings"
                           FontSize="22" FontFamily="Segoe UI"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- InfoBars -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing"
                                  IsActive="False"
                                  Width="22" Height="22"
                                  Foreground="#2563EB"
                                  Margin="0,0,10,0"/>
                    <TextBlock Text="Saving changes…"
                               FontSize="13" Foreground="#64748B"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="True"/>

                <InfoBar x:Name="SuccessInfoBar"
                         Severity="Success"
                         IsOpen="False"
                         IsClosable="True"/>
            </StackPanel>

            <!-- Body -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────────────────────────
                     PROFILE CARD
                ───────────────────────────── -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20,28"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Avatar -->
                        <Border Width="80" Height="80"
                                CornerRadius="40"
                                Background="#EFF4FF"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <FontIcon Glyph="&#xE77B;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="#2563EB"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <!-- Populated from code-behind via ViewModel.CurrentUser -->
                        <TextBlock x:Name="ProfileCardName"
                                   FontSize="15" FontFamily="Segoe UI Semibold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,12"/>

                        <StackPanel>
                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardEmail"
                                       FontSize="12" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardPhone"
                                       FontSize="13" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardAddress"
                                       FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ─────────────────────────────
                     TAB PANEL
                ───────────────────────────── -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        VerticalAlignment="Top">
                    <StackPanel>

                        <!-- Tab Headers -->
                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal">

                                <Button x:Name="TabPersonalBtn"
                                        Content="Personal Information"
                                        Style="{StaticResource TabButtonActiveStyle}"
                                        Click="TabPersonalBtn_Click"/>

                                <Button x:Name="TabSecurityBtn"
                                        Content="Security Settings"
                                        Style="{StaticResource TabButtonStyle}"
                                        Click="TabSecurityBtn_Click"/>

                                <Button x:Name="TabNotificationsBtn"
                                        Content="Notification Preferences"
                                        Style="{StaticResource TabButtonStyle}"
                                        Click="TabNotificationsBtn_Click"/>

                            </StackPanel>
                        </Border>

                        <!-- Tab Content -->
                        <Grid Margin="28,24,28,28">

                            <!-- ══════════════════════════
                                 TAB 1 — Personal Info
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelPersonal" Visibility="Visible">

                                <TextBlock Text="Personal Information"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <!-- Row 1: Full Name + Email (read-only) -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="FullNameBox"
                                                 Style="{StaticResource InputStyle}"
                                                 IsReadOnly="True"
                                                 Opacity="0.6"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="EmailBox"
                                                 Style="{StaticResource InputStyle}"
                                                 IsReadOnly="True"
                                                 Opacity="0.6"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Phone + Address (editable) -->
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Phone Number" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="PhoneBox"
                                                 Style="{StaticResource InputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="AddressBox"
                                                 Style="{StaticResource InputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="SaveButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="UPDATE"
                                        HorizontalAlignment="Center"
                                        Width="160"
                                        Click="SaveButton_Click"/>

                            </StackPanel>

                            <!-- ══════════════════════════
                                 TAB 2 — Security
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelSecurity" Visibility="Collapsed">

                                <TextBlock Text="Security Settings"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Current Password"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="CurrentPasswordBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource PasswordStyle}"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="4,0,0,0"
                                                Click="ToggleCurrentPassword_Click">
                                            <FontIcon Glyph="&#xE7B3;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Foreground="#64748B"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border Background="#F8FAFC" CornerRadius="10"
                                        Padding="16,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Change Password"
                                                   FontSize="14" FontFamily="Segoe UI Semibold"
                                                   Foreground="#1E293B" Margin="0,0,0,14"/>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="New Password"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="NewPasswordBox"
                                                             Grid.Column="0"
                                                             Style="{StaticResource PasswordStyle}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Click="ToggleNewPassword_Click">
                                                    <FontIcon Glyph="&#xE7B3;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="16" Foreground="#64748B"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Confirm Password"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="ConfirmPasswordBox"
                                                             Grid.Column="0"
                                                             Style="{StaticResource PasswordStyle}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Click="ToggleConfirmPassword_Click">
                                                    <FontIcon Glyph="&#xE7B3;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="16" Foreground="#64748B"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <Button x:Name="UpdatePasswordButton"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="UPDATE PASSWORD"
                                                HorizontalAlignment="Left"
                                                Width="180"
                                                Click="UpdatePasswordButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2FA -->
                                <Border Background="#F8FAFC" CornerRadius="10"
                                        Padding="16,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Two-Factor Authentication (2FA)"
                                                           FontSize="14" FontFamily="Segoe UI Semibold"
                                                           Foreground="#1E293B"/>
                                                <TextBlock Text="Verify your identity via phone number"
                                                           FontSize="11.5" Foreground="#64748B"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="TwoFactorToggle"
                                                          Grid.Column="1"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          Toggled="TwoFactorToggle_Toggled"/>
                                        </Grid>
                                        <TextBlock Text="Phone Number"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TwoFactorPhoneBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputStyle}"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Margin="4,0,0,0"
                                                    Click="SaveTwoFactorPhone_Click">
                                                <FontIcon Glyph="&#xE70F;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="#64748B"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Connected Accounts -->
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Connected Accounts"
                                                   FontSize="14" FontFamily="Segoe UI Semibold"
                                                   Foreground="#1E293B" Margin="0,0,0,12"/>

                                        <!-- Populated from code-behind via ViewModel.OAuthLinks -->
                                        <StackPanel x:Name="OAuthLinksPanel" Margin="0,0,0,10"/>

                                        <Button x:Name="ManageDevicesButton"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Click="ManageDevicesButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE8FA;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12" Margin="0,0,6,0"
                                                          Foreground="#2563EB"/>
                                                <TextBlock Text="Manage Device Connections"
                                                           Foreground="#2563EB"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- ══════════════════════════
                                 TAB 3 — Notifications
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelNotifications" Visibility="Collapsed">

                                <TextBlock Text="Manage Notifications"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Choose which alerts and updates you want to receive."
                                           FontSize="13" Foreground="#64748B"
                                           Margin="0,-8,0,20"/>

                                <!-- Populated from code-behind via ViewModel.NotificationPreferences -->
                                <Border BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="20,6" Background="#FAFBFF">
                                    <StackPanel x:Name="NotificationPreferencesPanel"/>
                                </Border>

                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>
</Page>
