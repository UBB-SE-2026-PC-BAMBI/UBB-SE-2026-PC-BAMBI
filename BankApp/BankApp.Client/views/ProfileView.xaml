<Page
    x:Class="BankApp.Client.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F4F6FA">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBlue"       Color="#1A3C6E"/>
        <SolidColorBrush x:Key="AccentBlue"        Color="#2563EB"/>
        <SolidColorBrush x:Key="LightBlue"         Color="#EFF4FF"/>
        <SolidColorBrush x:Key="SidebarBg"         Color="#0F2A4A"/>
        <SolidColorBrush x:Key="SidebarText"       Color="#B0C4DE"/>
        <SolidColorBrush x:Key="SidebarActiveBg"   Color="#2563EB"/>
        <SolidColorBrush x:Key="CardBg"            Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor"       Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary"       Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary"     Color="#64748B"/>
        <SolidColorBrush x:Key="InputBg"           Color="#F8FAFC"/>
        <SolidColorBrush x:Key="DangerRed"         Color="#EF4444"/>

        <!-- Sidebar Nav Button -->
        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="#B0C4DE"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                    Value="20,10"/>
            <Setter Property="FontSize"                   Value="13"/>
            <Setter Property="FontFamily"                 Value="Segoe UI"/>
            <Setter Property="CornerRadius"               Value="6"/>
            <Setter Property="Margin"                     Value="8,2"/>
        </Style>

        <!-- Active Nav Button -->
        <Style x:Key="NavItemActiveStyle" TargetType="Button" BasedOn="{StaticResource NavItemStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="#2563EB"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="24,10"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- Outline Button -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#2563EB"/>
            <Setter Property="BorderBrush"     Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
            <Setter Property="CornerRadius"    Value="6"/>
        </Style>

        <!-- Ghost Button (icon-only) -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Width"           Value="34"/>
        </Style>

        <!-- TextBox Input -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CornerRadius"    Value="6"/>
        </Style>

        <!-- PasswordBox -->
        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Height"          Value="38"/>
            <Setter Property="CornerRadius"    Value="6"/>
        </Style>

        <!-- Field Label -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Section Title -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin"     Value="0,0,0,16"/>
        </Style>

    </Page.Resources>

    <!-- Root: Sidebar + Main -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════
             SIDEBAR
        ════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#0F2A4A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Border Grid.Row="0" Padding="20,24,20,16">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="#2563EB" Margin="0,0,10,0">
                        <TextBlock Text="B" FontSize="18" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BankApp" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Divider -->
            <Border Grid.Row="1" Height="1" Background="#1E3A5F" Margin="16,0"/>

            <!-- Nav Items -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden"
                          Padding="0,12,0,0">
                <StackPanel>

                    <Button Style="{StaticResource NavItemStyle}"
                            Click="DashboardNavButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8AB;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Transfers" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8C7;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Bill Payments" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8C0;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Cards" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Transaction History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8A1;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Currency Exchange" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8D6;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Savings &amp; Loans" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Investments &amp; Trading" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Statistics" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource NavItemStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE8F2;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Support" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Profile — Active -->
                    <Button Style="{StaticResource NavItemActiveStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="Profile" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <!-- Logout -->
            <Border Grid.Row="3" Padding="8,12">
                <Button x:Name="LogoutButton"
                        Style="{StaticResource NavItemStyle}"
                        Click="LogoutButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe MDL2 Assets"
                                  FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Logout" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════
             MAIN CONTENT
        ════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Profile"
                           FontSize="22" FontFamily="Segoe UI Semibold"
                           Foreground="#1E293B"/>
                <TextBlock Text=" / Settings"
                           FontSize="22" FontFamily="Segoe UI"
                           Foreground="#64748B"/>
            </StackPanel>

            <!-- InfoBars -->
            <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="6">
                <StackPanel x:Name="LoadingPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <ProgressRing x:Name="LoadingRing"
                                  IsActive="False"
                                  Width="22" Height="22"
                                  Foreground="#2563EB"
                                  Margin="0,0,10,0"/>
                    <TextBlock Text="Saving changes…"
                               FontSize="13" Foreground="#64748B"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <InfoBar x:Name="ErrorInfoBar"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="True"/>

                <InfoBar x:Name="SuccessInfoBar"
                         Severity="Success"
                         IsOpen="False"
                         IsClosable="True"/>
            </StackPanel>

            <!-- Body -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─────────────────────────────
                     PROFILE CARD
                ───────────────────────────── -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="14"
                        Padding="20,28"
                        VerticalAlignment="Top">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Avatar -->
                        <Border Width="80" Height="80"
                                CornerRadius="40"
                                Background="#EFF4FF"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                            <FontIcon Glyph="&#xE77B;"
                                      FontFamily="Segoe MDL2 Assets"
                                      FontSize="36"
                                      Foreground="#2563EB"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="ProfileCardName"
                                   Text="Anamaria Prodan"
                                   FontSize="15" FontFamily="Segoe UI Semibold"
                                   Foreground="#1E293B"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>

                        <Border Height="1" Background="#E2E8F0" Margin="0,12"/>

                        <StackPanel>
                            <TextBlock Text="Date of Birth" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardDob"
                                       Text="10 March"
                                       FontSize="13" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardEmail"
                                       Text="muresonianisa@..."
                                       FontSize="12" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

                            <TextBlock Text="Phone" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardPhone"
                                       Text="+40 770 331 808"
                                       FontSize="13" Foreground="#1E293B" Margin="0,0,0,10"/>

                            <TextBlock Text="Address" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock x:Name="ProfileCardAddress"
                                       Text="430293 Residency"
                                       FontSize="13" Foreground="#1E293B"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ─────────────────────────────
                     TAB PANEL
                ───────────────────────────── -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="14"
                        VerticalAlignment="Top">
                    <StackPanel>

                        <!-- Tab Headers -->
                        <Border BorderBrush="#E2E8F0"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal">

                                <Button x:Name="TabPersonalBtn"
                                        Content="Personal Information"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="#2563EB"
                                        Foreground="#2563EB"
                                        Padding="16,10"
                                        FontSize="13"
                                        FontFamily="Segoe UI Semibold"
                                        Click="TabPersonalBtn_Click"/>

                                <Button x:Name="TabSecurityBtn"
                                        Content="Security Settings"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Foreground="#64748B"
                                        Padding="16,10"
                                        FontSize="13"
                                        FontFamily="Segoe UI Semibold"
                                        Click="TabSecurityBtn_Click"/>

                                <Button x:Name="TabNotificationsBtn"
                                        Content="Notification Preferences"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Foreground="#64748B"
                                        Padding="16,10"
                                        FontSize="13"
                                        FontFamily="Segoe UI Semibold"
                                        Click="TabNotificationsBtn_Click"/>

                            </StackPanel>
                        </Border>

                        <!-- Tab Content -->
                        <Grid Margin="28,24,28,28">

                            <!-- ══════════════════════════
                                 TAB 1 — Personal Info
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelPersonal" Visibility="Visible">

                                <TextBlock Text="Personal Information"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Full Name" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="FullNameBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="Anamaria Prodan"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="EmailBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="muresonianisa@..."/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Phone Number" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="PhoneBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="+40 310 245 221"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Billing Address" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="BillingAddressBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="2490 Grove Street"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="City" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="CityBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="Cluj-Napoca"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="State / County" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="StateBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="Cluj"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Postcode" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="PostcodeBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="430 293"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Country" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox x:Name="CountryBox"
                                                 Style="{StaticResource InputStyle}"
                                                 Text="Romania"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="SaveButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Content="UPDATE"
                                        HorizontalAlignment="Center"
                                        Width="160"
                                        Click="SaveButton_Click"/>

                            </StackPanel>

                            <!-- ══════════════════════════
                                 TAB 2 — Security
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelSecurity" Visibility="Collapsed">

                                <TextBlock Text="Security Settings"
                                           Style="{StaticResource SectionTitleStyle}"/>

                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="Current Password"
                                               Style="{StaticResource FieldLabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="38"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="CurrentPasswordBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource PasswordStyle}"
                                                     Password="****"/>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Margin="4,0,0,0"
                                                Click="ToggleCurrentPassword_Click">
                                            <FontIcon Glyph="&#xE7B3;"
                                                      FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Foreground="#64748B"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <Border Background="#F8FAFC" CornerRadius="10"
                                        Padding="16,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Change Password"
                                                   FontSize="14" FontFamily="Segoe UI Semibold"
                                                   Foreground="#1E293B" Margin="0,0,0,14"/>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="New Password"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="NewPasswordBox"
                                                             Grid.Column="0"
                                                             Style="{StaticResource PasswordStyle}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Click="ToggleNewPassword_Click">
                                                    <FontIcon Glyph="&#xE7B3;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="16" Foreground="#64748B"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Confirm Password"
                                                       Style="{StaticResource FieldLabelStyle}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="38"/>
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="ConfirmPasswordBox"
                                                             Grid.Column="0"
                                                             Style="{StaticResource PasswordStyle}"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Margin="4,0,0,0"
                                                        Click="ToggleConfirmPassword_Click">
                                                    <FontIcon Glyph="&#xE7B3;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="16" Foreground="#64748B"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <Button x:Name="UpdatePasswordButton"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Content="UPDATE PASSWORD"
                                                HorizontalAlignment="Left"
                                                Width="180"
                                                Click="UpdatePasswordButton_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 2FA -->
                                <Border Background="#F8FAFC" CornerRadius="10"
                                        Padding="16,14" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Two-Factor Authentication (2FA)"
                                                           FontSize="14" FontFamily="Segoe UI Semibold"
                                                           Foreground="#1E293B"/>
                                                <TextBlock Text="Verify your identity via phone number"
                                                           FontSize="11.5" Foreground="#64748B"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="TwoFactorToggle"
                                                          Grid.Column="1"
                                                          IsOn="True"
                                                          OnContent="" OffContent=""
                                                          VerticalAlignment="Center"
                                                          Toggled="TwoFactorToggle_Toggled"/>
                                        </Grid>
                                        <TextBlock Text="Phone Number"
                                                   Style="{StaticResource FieldLabelStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="38"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TwoFactorPhoneBox"
                                                     Grid.Column="0"
                                                     Style="{StaticResource InputStyle}"
                                                     Text="+40 50508050"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Margin="4,0,0,0"
                                                    Click="SaveTwoFactorPhone_Click">
                                                <FontIcon Glyph="&#xE70F;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="#64748B"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Connected Accounts -->
                                <Border Background="#F8FAFC" CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <TextBlock Text="Connected Accounts"
                                                   FontSize="14" FontFamily="Segoe UI Semibold"
                                                   Foreground="#1E293B" Margin="0,0,0,12"/>

                                        <Border BorderBrush="#E2E8F0" BorderThickness="1"
                                                CornerRadius="6" Padding="10,8"
                                                Background="White" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="name@gmail.com"
                                                           FontSize="13" Foreground="#1E293B"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Margin="0,0,6,0"
                                                        Click="EditConnectedAccount_Click">
                                                    <FontIcon Glyph="&#xE70F;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="13" Foreground="#64748B"/>
                                                </Button>
                                                <Button Grid.Column="2"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Click="RemoveConnectedAccount_Click">
                                                    <FontIcon Glyph="&#xE711;"
                                                              FontFamily="Segoe MDL2 Assets"
                                                              FontSize="13" Foreground="#EF4444"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <Button x:Name="ManageDevicesButton"
                                                Style="{StaticResource OutlineButtonStyle}"
                                                Click="ManageDevicesButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Glyph="&#xE8FA;"
                                                          FontFamily="Segoe MDL2 Assets"
                                                          FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Manage Device Connections"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- ══════════════════════════
                                 TAB 3 — Notifications
                            ══════════════════════════ -->
                            <StackPanel x:Name="PanelNotifications" Visibility="Collapsed">

                                <TextBlock Text="Manage Notifications"
                                           Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="Choose which alerts and updates you want to receive."
                                           FontSize="13" Foreground="#64748B"
                                           Margin="0,-8,0,20"/>

                                <Border BorderBrush="#E2E8F0" BorderThickness="1"
                                        CornerRadius="10" Padding="20,6" Background="#FAFBFF">
                                    <StackPanel>

                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Transaction Alerts"
                                                               FontSize="13.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="#1E293B"/>
                                                    <TextBlock Text="Get notified about every transaction on your account"
                                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="TransactionAlertsToggle"
                                                              Grid.Column="1" IsOn="False"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              Toggled="NotificationToggle_Toggled"/>
                                            </Grid>
                                        </Border>

                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Login Alerts"
                                                               FontSize="13.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="#1E293B"/>
                                                    <TextBlock Text="Receive an alert when a new device logs into your account"
                                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="LoginAlertsToggle"
                                                              Grid.Column="1" IsOn="False"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              Toggled="NotificationToggle_Toggled"/>
                                            </Grid>
                                        </Border>

                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Bill Payment Reminder"
                                                               FontSize="13.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="#1E293B"/>
                                                    <TextBlock Text="Remind me 7 days before a bill is due"
                                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="BillReminderToggle"
                                                              Grid.Column="1" IsOn="True"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              Toggled="NotificationToggle_Toggled"/>
                                            </Grid>
                                        </Border>

                                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Marketing and Offers"
                                                               FontSize="13.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="#1E293B"/>
                                                    <TextBlock Text="Receive personalised offers and promotions"
                                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="MarketingToggle"
                                                              Grid.Column="1" IsOn="False"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              Toggled="NotificationToggle_Toggled"/>
                                            </Grid>
                                        </Border>

                                        <Border Padding="0,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Maximum Spending Alert"
                                                               FontSize="13.5" FontFamily="Segoe UI Semibold"
                                                               Foreground="#1E293B"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="Alert when spending exceeds "
                                                                   FontSize="11.5" Foreground="#64748B"/>
                                                        <Border BorderBrush="#E2E8F0" BorderThickness="1"
                                                                CornerRadius="4" Padding="6,1" Background="White">
                                                            <TextBlock Text="$1,000" FontSize="11.5"
                                                                       Foreground="#2563EB"
                                                                       FontFamily="Segoe UI Semibold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <ToggleSwitch x:Name="SpendingAlertToggle"
                                                              Grid.Column="1" IsOn="False"
                                                              OnContent="" OffContent=""
                                                              VerticalAlignment="Center"
                                                              Toggled="NotificationToggle_Toggled"/>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </Border>

                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>
</Page>
